CONTRACT_ROOT=../../Contract
R4CC_ROOT=../R4CC
R4PACK_ROOT=../R4Pack

DEVKIT_ROOT=../../../DevKit
ARTIFACTS_ROOT=../../../Artifacts/Modules/R4Build
ZIG_ROOT=Toolchains/Zig
